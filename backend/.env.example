# ==================== 复制本文件为 .env 后按需修改 ====================

# ---------- LLM ----------
# openai = 任意 OpenAI 兼容云端端点；ollama = 本地 Ollama
LLM_PROVIDER=openai

# DeepSeek（推荐，性价比高）
# 注意：API Key 必须是纯 ASCII，填中文会导致 HTTP header 编码报错
OPENAI_API_KEY=sk-REPLACE_WITH_YOUR_KEY
OPENAI_BASE_URL=https://api.deepseek.com/v1
OPENAI_MODEL=deepseek-chat
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=4096

# 其他厂商只需改这三行（协议完全兼容）：
#   通义千问: OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  OPENAI_MODEL=qwen-plus
#   智谱 GLM: OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4          OPENAI_MODEL=glm-4-flash
#   OpenAI  : OPENAI_BASE_URL=https://api.openai.com/v1                     OPENAI_MODEL=gpt-4o-mini

# 本地 Ollama（改 LLM_PROVIDER=ollama 时生效）
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_API_KEY=ollama
# qwen3.x 是推理模型，开启思考会把 token 额度吃光导致答案为空，建议保持 false
OLLAMA_THINK=false
OLLAMA_MAX_TOKENS=2048

# ---------- Embedding（视频与长文向量化共用）----------
# local = 本地 ONNX 模型（免 torch，CPU 可跑）；openai/ollama = 远端端点
EMBED_PROVIDER=local
LOCAL_EMBED_MODEL=BAAI/bge-small-zh-v1.5
LOCAL_EMBED_DIM=512
EMBED_BATCH_SIZE=32
# 若改用云端 embedding，取消下面注释并填模型名
# OPENAI_EMBED_MODEL=text-embedding-v3

# 国内首次下载本地模型若卡住，在启动前设置：
#   Windows PowerShell: $env:HF_ENDPOINT="https://hf-mirror.com"
#   Git Bash:           export HF_ENDPOINT=https://hf-mirror.com

# ---------- 联网搜索 ----------
# auto=Tavily 优先失败降级 DuckDuckGo；tavily / duckduckgo / off
SEARCH_PROVIDER=auto
TAVILY_API_KEY=
SEARCH_MAX_RESULTS=5

# ---------- 存储 ----------
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_TTL_SECONDS=604800
DATA_DIR=./data
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=study_buddy

# ---------- ASR ----------
WHISPER_MODEL_SIZE=small
# cpu / cuda / auto。auto = 自动查找 CUDA 12 运行库，找到就走 GPU（首次加载做真实自检，
# 失败自动退回 CPU）。查找顺序：WHISPER_CUDA_DLL_DIR → venv 里的 nvidia-*-cu12 轮子
# → 本机 Ollama 自带的 lib/ollama/cuda_v12（零下载即可用）。实测 8 分钟音频：
# CPU 106s vs GPU 17s。
WHISPER_DEVICE=auto
# 留空 = 按设备自动选（cuda → int8_float16，cpu → int8）
WHISPER_COMPUTE_TYPE=
# 手动指定 CUDA 运行库目录（含 cublas64_12.dll）；留空 = 自动查找
WHISPER_CUDA_DLL_DIR=
# 解码束宽：越大越准、越慢。CPU 上设 1 约省 1/3 时间，GPU 上影响很小
WHISPER_BEAM_SIZE=5
# auto/空 = 自动检测语种（中英混合、英文视频请用 auto）；zh/en/ja… 才强制指定
WHISPER_LANGUAGE=auto
# 留空则自动探测系统 ffmpeg，失败时回退到 imageio-ffmpeg 内置二进制
FFMPEG_PATH=

# ---------- RAG ----------
MAX_ARTICLE_CHARS=24000
# 文章正文超过这个字数才切块向量化；以内则整篇直投给模型（更快，模型也能看到全文）
ARTICLE_VECTORIZE_MIN_CHARS=8000
VIDEO_TOP_K=4
# 文章块的信息密度高于字幕块，回答「全文讲了什么」这类问题需要多取几块
ARTICLE_TOP_K=6
SCORE_THRESHOLD=0.30
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# ---------- 视频画面识别（Vision）----------
# 抽帧后交给视觉模型描述画面，再与字幕一起送进摘要，让总结同时覆盖「听到的」和「看到的」。
# 默认「跟随主模型」：下面两项留空即复用 LLM_PROVIDER 及其主模型。
# 只要主模型支持视觉（ollama 下的 qwen3.5 / qwen2.5vl / llava / minicpm-v 等），无需额外配置。
# 失败不会中断流程：自动降级为「仅字幕」摘要。
VISION_ENABLED=true
# ollama = 本地视觉模型；openai = 云端支持图像的兼容端点（如 gpt-4o、qwen-vl）
# 留空 = 跟随 LLM_PROVIDER
VISION_PROVIDER=
# 留空 = 复用该 provider 的主模型（需支持视觉）
# 想让「文字用 A 模型、画面用 B 模型」时在这里显式指定，例如 VISION_MODEL=qwen2.5vl:7b
VISION_MODEL=
# 留空则复用主 LLM 的地址与 Key
VISION_BASE_URL=
VISION_API_KEY=
# 目标抽帧间隔（秒），实际帧数受 VISION_MAX_FRAMES 限制
VISION_FRAME_INTERVAL=30
# 单视频最多分析帧数（控制耗时与成本）
VISION_MAX_FRAMES=20
# 抽帧缩放宽度，越小越省 token
VISION_FRAME_WIDTH=768
# 每次请求送几张画面
VISION_BATCH=4
VISION_MAX_TOKENS=1500
